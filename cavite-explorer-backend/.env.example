MOBILE_AUTH_CALLBACK_URL=http://localhost:3000/auth/callback
PARTNER_INVITE_WEB_URL=http://localhost:3000/auth/partner-invite
MOBILE_RESET_CALLBACK_URL=http://localhost:3001/reset-password?client=mobile
